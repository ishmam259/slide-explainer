# Copy to backend/.env and fill in. backend/.env is git-ignored — never commit your key.

# Your OpenAI API key (added by you; the app never sends it to the browser)
OPENAI_API_KEY=

# Model per role (allowed: up to GPT-5.5). Default: gpt-5.4-nano for every chat role.
SLIDEX_MODEL_STRONG=gpt-5.4-nano
SLIDEX_MODEL_VISION=gpt-5.4-nano
SLIDEX_MODEL_BULK=gpt-5.4-nano
SLIDEX_MODEL_SEARCH=gpt-5.4-nano
SLIDEX_MODEL_EMBED=text-embedding-3-small

# Reasoning effort per role: none | low | medium | high | xhigh
SLIDEX_EFFORT_STRONG=medium
SLIDEX_EFFORT_VISION=low
SLIDEX_EFFORT_BULK=none
SLIDEX_EFFORT_SEARCH=low

# LibreOffice (renders PPTX slides)
SLIDEX_SOFFICE=C:\Program Files\LibreOffice\program\soffice.exe

# Where the local database and files live (relative to backend/)
SLIDEX_DATA_DIR=../data

# Parallel model calls
SLIDEX_CONCURRENCY=6

# Research budget per run
SLIDEX_MAX_TOPICS=15
SLIDEX_SEARCHES_PER_TOPIC=2
SLIDEX_PAGES_PER_TOPIC=8

# Tests/dev only: 1 = never call OpenAI (deterministic fake responses)
SLIDEX_FAKE_LLM=0
